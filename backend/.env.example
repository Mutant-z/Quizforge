# QuizTrace 后端环境变量示例
# 复制为 .env 后按需修改

# 服务
QT_SERVER_HOST=0.0.0.0
QT_SERVER_PORT=8080
QT_ENV=development

# 数据库（SQLite）
QT_DATABASE_PATH=./data/app.db
QT_DB_BUSY_TIMEOUT_MS=5000

# 上传
QT_UPLOAD_ROOT=./data
QT_UPLOAD_CHUNK_SIZE_MB=5
QT_UPLOAD_MAX_FILE_SIZE_MB=2048
QT_UPLOAD_MAX_PAGES=5000

# Worker
QT_WORKER_IMPORT_CONCURRENCY=1
QT_WORKER_LLM_CONCURRENCY=3
QT_WORKER_EMBEDDING_CONCURRENCY=2
QT_WORKER_POLL_INTERVAL_MS=2000
QT_WORKER_LEASE_SECONDS=300
QT_IMPORT_DIRECTORY_CONCURRENCY=3
QT_IMPORT_EXTRACTION_CONCURRENCY=2
QT_VISION_IMPORT_MAX_PAGES=500
QT_IMPORT_LLM_LOCAL_INITIAL_CONCURRENCY=2
QT_IMPORT_LLM_REMOTE_INITIAL_CONCURRENCY=3
QT_IMPORT_LLM_MAX_CONCURRENCY=3
QT_IMPORT_VISION_TIMEOUT_SECONDS=240
QT_IMPORT_CIRCUIT_BREAKER_SECONDS=60
QT_IMPORT_NO_PROGRESS_WARNING_SECONDS=180

# 认证
QT_JWT_SECRET=change-me-to-a-long-random-secret
QT_ACCESS_TOKEN_TTL_MIN=120
QT_REFRESH_TOKEN_TTL_DAYS=30
QT_RATE_LIMIT_PER_MIN=120

# AI Provider Key 加密（AES-GCM Master Key，生产必改）
QT_API_KEY_MASTER_KEY=

# Agent
QT_AGENT_MAX_STEPS=8
QT_IMPORT_AGENT_V2_ENABLED=true
# 可选：服务进程无法从 PATH 找到 Poppler 时指定 pdftoppm 绝对路径。
# Apple Silicon Homebrew 通常为 /opt/homebrew/bin/pdftoppm。
QT_PDFTOPPM_PATH=

# RAG
QT_RAG_FTS_TOP_K=20
QT_RAG_VECTOR_TOP_K=20
QT_RAG_FINAL_TOP_K=6

# 复习调度
QT_REVIEW_SCHEDULER=simple_v1

# 前端静态目录（生产模式 Go 直接托管前端构建产物，可选）
QT_FRONTEND_DIR=
